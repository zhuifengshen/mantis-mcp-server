{
  "name": "@youcloud/mantis-mcp-server",
  "version": "6.0.0",
  "description": "面向研发工作流的 MantisBT MCP 服务，支持缺陷查询、修复登记、附件和可恢复操作",
  "author": "Dominik Pesch",
  "license": "MIT",
  "homepage": "https://github.com/zhuifengshen/mantis-mcp-server",
  "bugs": {
    "url": "https://github.com/zhuifengshen/mantis-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuifengshen/mantis-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mantisbt",
    "bugtracker",
    "mantis",
    "issue-tracker",
    "bug-tracker",
    "model-context-protocol",
    "claude",
    "claude-code"
  ],
  "main": "dist/index.js",
  "bin": {
    "mantis-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/cookbook.md",
    "docs/examples.md",
    "docs/migration-v6.md",
    "docs/workflow-config.example.json"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "dev:start": "npm run typecheck && npm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:record": "tsx scripts/record-fixtures.ts",
    "init": "node scripts/init.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
